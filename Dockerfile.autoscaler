FROM docker:27-cli AS docker-cli

RUN mkdir -p /docker-out/cli-plugins \
    && cp "$(command -v docker)" /docker-out/docker \
    && compose_path="$(find /usr/local/libexec /usr/local/lib /usr/libexec /usr/lib -name docker-compose -type f 2>/dev/null | head -n 1)" \
    && if [ -n "$compose_path" ]; then cp "$compose_path" /docker-out/cli-plugins/docker-compose; fi

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/source

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /docker-out/docker /usr/local/bin/docker
COPY --from=docker-cli /docker-out/cli-plugins /usr/local/libexec/docker/cli-plugins

RUN chmod +x /usr/local/bin/docker \
    && if [ -f /usr/local/libexec/docker/cli-plugins/docker-compose ]; then chmod +x /usr/local/libexec/docker/cli-plugins/docker-compose; fi \
    && pip install --no-cache-dir pymongo redis requests psutil

COPY source/infrastructure/autoscaler /app/source/infrastructure/autoscaler

CMD ["python", "-m", "infrastructure.autoscaler.service"]
